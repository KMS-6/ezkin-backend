AAC_DATABASE_URL=postgresql+asyncpg://aac:aac@localhost:5432/aac
AAC_API_PREFIX=/api/v1
AAC_DEBUG=false
AAC_CORS_ORIGINS=["http://localhost:5173"]
AAC_AUTH_SECRET=replace-with-a-long-random-secret
AAC_ADMIN_API_KEY=replace-with-a-long-random-secret
AAC_PARTNER_API_KEY=replace-with-a-long-random-secret
AAC_ACCESS_TOKEN_TTL_SECONDS=86400
# 선택 사항: 비워두면 챗봇의 LLM escalation(파싱 신뢰도 낮을 때 보정)이 꺼지고 규칙
# 기반 재질문으로만 동작한다. 기능명세서_chatbot.md 10.2/10.5절 — 저비용 모델 기본값.
AAC_ANTHROPIC_API_KEY=
AAC_CHAT_LLM_MODEL=claude-haiku-4-5
# 페르소나당 하루 LLM escalation 호출 상한(비용 폭주 방지). 0으로 두면 항상 스킵.
AAC_CHAT_LLM_DAILY_CAP_PER_PERSONA=20
# 선택 사항: 비워두면 카메라 스캔(Vision AI Input)이 계속 model_not_implemented로
# 폴백한다. OpenAI API Platform에서 발급한 키를 넣으면 실제 분석이 동작한다.
AAC_OPENAI_API_KEY=
AAC_VISION_LLM_MODEL=gpt-4o-mini
